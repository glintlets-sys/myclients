{
  "name": "Wilber Admin",
  "short_name": "Wilber Admin",
  "description": "Orders, products and customers for the Wilber store",
  "id": "/m/",
  "start_url": "/m/home",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f3f5f8",
  "theme_color": "#065baa",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "New order", "url": "/m/new-order", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Orders", "url": "/m/orders", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Confirm orders", "url": "/m/confirmations", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
